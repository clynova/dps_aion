{
  "name": "dps-aion",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "textos": "node scripts/extraer-textos.mjs",
    "db:generar": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs generate",
    "db:migrar": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "build:vercel": "node node_modules/drizzle-kit/bin.cjs migrate && next build",
    "migrar": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/migrar-json.mts",
    "paridad": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/paridad.mts",
    "comparar-paginas": "node --import tsx scripts/comparar-paginas.mts"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "better-auth": "1.7.18",
    "d3": "7.9.2",
    "drizzle-orm": "0.45.4",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/d3": "7.4.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
