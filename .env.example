# Variables de entorno (copia a .env.local para desarrollo; en Vercel van en Settings → Environment Variables).
# Nunca subas valores reales al repo.

# Base de datos (Neon). En local, la rama «dev» de Neon; en Vercel las pone la integración de Neon.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Login con Discord (Better Auth)
AUTH_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Análisis automático con IA (DeepSeek). Sin clave, el botón «Analizar con IA» no aparece y no se analiza al subir.
DEEPSEEK_API_KEY=
# Opcionales: modelo (deepseek-flash por defecto, o deepseek-v4-pro), razonamiento (no | low | high | max) y URL base.
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_RAZONAMIENTO=no
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Cron diario de nombres (/api/cron/nombres): Vercel lo envía como «Authorization: Bearer …». Un texto largo aleatorio.
CRON_SECRET=

# Administradores de la web (panel /admin/uso): ids de Discord (o de la tabla user) separados por comas.
SITE_ADMINS=
